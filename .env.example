# =============================================================================
# MCP SERVER ENVIRONMENT VARIABLES
# =============================================================================

# GitHub - Code repository management
# Create at: https://github.com/settings/tokens
# Permissions: repo, read:org, read:user
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token_here

# Supabase MCP Server
# Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here
SUPABASE_PROJECT_REF=your_supabase_project_reference_here

# Netlify - Static site deployment
# Get from: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=your_netlify_auth_token_here

# Cloudinary - Image and video management
# Get from: https://cloudinary.com/console/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Replicate - AI image generation service
# Get from: https://replicate.com/account/api-tokens
VITE_REPLICATE_API_TOKEN=your_replicate_api_token_here

# Firecrawl - Web scraping service (REQUIRED for Business Brain)
# Get from: https://www.firecrawl.dev/app/api-keys
# Used by: Business Brain auto-initialization to scrape websites
# Free tier: 500 credits/month (1 credit per page)
VITE_FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Brandfetch - Brand color detection (OPTIONAL for Business Brain)
# Get from: https://brandfetch.com/dashboard/api
# Used by: Business Brain to extract brand colors from websites
# Free tier: 100 requests/month
VITE_BRANDFETCH_API_KEY=your_brandfetch_api_key_here

# =============================================================================
# AI GENERATION SERVICES
# =============================================================================

# OpenAI - Image generation & embeddings (REQUIRED for Business Brain)
# Get from: https://platform.openai.com/api-keys
# Uses:
#   1. Image generation: gpt-image-1 ONLY (DALL-E absolutely forbidden)
#   2. Text embeddings: text-embedding-3-small for Business Brain vector search
# Features:
#   - gpt-image-1: Natively multimodal, streaming, C2PA metadata
#   - text-embedding-3-small: 1536 dimensions, $0.02 per 1M tokens
# Pricing:
#   - Images: $0.02-$0.19 per image depending on size
#   - Embeddings: ~$0.00003 per brain fact (15 facts = $0.0005)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini - gemini-2.5-flash-image-preview (Nano Banana)
# Get from: https://aistudio.google.com/app/apikey
# Features: Image generation, editing, composition, character consistency, SynthID watermark
# Pricing: $0.039 per image (fixed)
# SDK: Uses @google/genai v1.21.0+
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs - Voice synthesis and cloning
# Get from: https://elevenlabs.io/app/settings/api-keys
# Supports: Voice cloning, TTS, multilingual synthesis
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Anthropic Claude - Business Brain & AutoBlog System
# Get from: https://console.anthropic.com/settings/keys
# Models: Claude Sonnet 4.5 (recommended), Claude Opus 4.1, Claude Haiku
# Primary Uses:
#   1. BUSINESS BRAIN SYSTEM (NEW):
#      - Brain auto-initialization: Extract business intelligence from websites
#      - AI-powered onboarding: 10-question conversation to build knowledge base
#      - Content generation: Blog articles, titles, social posts with brand context
#      - Fact extraction: From files, conversations, integrations
#      - See docs/BUSINESS_BRAIN_COMPLETE_SYSTEM.md for complete documentation
#   2. AutoBlog System:
#      - Generates 1,200+ word SEO-optimized articles
#      - Brand voice: Disruptors & Co (bold, contrarian, no-fluff)
#      - AIO & GEO optimization with Answer Boxes, FAQs, schema hints
#      - See docs/AUTOBLOG_SYSTEM.md for complete documentation
# SDK: @anthropic-ai/sdk (npm i @anthropic-ai/sdk)
# Pricing: ~$0.03-0.04 per brain initialization, ~$0.04 per article
# Rate Limiting: 2-second delays between batch requests (built-in)
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Cloud (for Vertex AI Veo access)
# Get from: Google Cloud Console
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id_here
GOOGLE_CLOUD_CREDENTIALS=your_google_cloud_credentials_json_here

# =============================================================================
# BLOG QA & HUMANIZATION SERVICES
# =============================================================================

# Undetectable.ai - AI text humanization & detection (OPTIONAL)
# Get from: https://undetectable.ai/develop
# Features:
#   - AI detection scoring (0.0-1.0)
#   - Content humanization for natural, bypass-AI-detection writing
#   - Readability control (High School, College, etc.)
# Pricing:
#   - Free trial: 100 words
#   - Starter: $5/month for 10,000 words
#   - Pro: $19/month for 50,000 words
# Used by: blog-humanize.js, blog-run-qa.js (AI detection step)
# Fallback: EdgeShop.ai (free, undocumented) → Claude Sonnet 4.5 (prompt-based)
UNDETECTABLE_API_KEY=your_undetectable_api_key_here

# LanguageTool - Grammar and style checking (OPTIONAL)
# Get from: https://languagetoolplus.com/ or self-host
# Features:
#   - Grammar, spelling, style checks
#   - Multi-language support
#   - Professional suggestions
# Pricing:
#   - Free tier: 20 requests/day
#   - Premium: $59/year (~110 checks/day)
# Used by: blog-run-qa.js (grammar check step)
# Fallback: Claude Sonnet 4.5 (prompt-based grammar check)
LANGUAGETOOL_API_URL=https://api.languagetoolplus.com/v2/check
LANGUAGETOOL_API_KEY=your_languagetool_api_key_here

# Google Perspective API - Toxicity detection (FREE)
# Get from: https://console.cloud.google.com/ → Enable Perspective API
# Features:
#   - Toxic language detection
#   - Bias detection
#   - Harmful content filtering
# Pricing: FREE (1 QPS rate limit)
# Used by: blog-run-qa.js (toxicity check step)
PERSPECTIVE_API_KEY=your_google_api_key_here

# Google Fact Check Tools API - Claim verification (FREE)
# Get from: https://console.cloud.google.com/ → Enable Fact Check Tools API
# Features:
#   - Search fact-checking databases
#   - Verify claims against published fact-checks
#   - Credible source identification
# Pricing: FREE
# Used by: blog-run-qa.js (fact-check step)
GOOGLE_FACT_CHECK_API_KEY=your_google_api_key_here

# SerpAPI - Plagiarism detection via Google Search (PAID)
# Get from: https://serpapi.com/
# Features:
#   - Google search API for exact phrase matches
#   - Plagiarism detection by content similarity
# Pricing:
#   - Free trial: 100 searches/month
#   - Starter: $50/month for 5,000 searches
#   - Pro: $150/month for 20,000 searches
# Used by: blog-run-qa.js (plagiarism check step)
SERPAPI_KEY=your_serpapi_key_here

# =============================================================================
# NOTES
# =============================================================================

# 1. Copy this file to .env and fill in your actual API keys
# 2. Never commit .env to git - it should be in your .gitignore
# 3. The MCP servers (memory, filesystem, fetch, puppeteer, sequential-thinking) 
#    work without API keys
# 4. URL-based servers (vercel) don't need environment variables
# 5. Remove unused services to keep your .env clean

# =============================================================================
# GETTING STARTED
# =============================================================================

# For basic MCP functionality, you only need:
# - GITHUB_PERSONAL_ACCESS_TOKEN (for GitHub integration)
# - SUPABASE_ACCESS_TOKEN and SUPABASE_PROJECT_REF (for database operations)

# For full web development workflow, also configure:
# - NETLIFY_AUTH_TOKEN (if using Netlify for deployment)
# - CLOUDINARY_* (if using image/video management)
# - FIRECRAWL_API_KEY (if using web scraping)
# - VITE_ANTHROPIC_API_KEY (for AutoBlog article generation system)

VITE_GOOGLE_SHEETS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX