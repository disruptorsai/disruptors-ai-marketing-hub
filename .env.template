# Disruptors MCP Suite - Environment Variables Template
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env file with real credentials!

# ============================================================
# CORE DEVELOPMENT
# ============================================================

# GitHub - Code Repository Management
# Get from: https://github.com/settings/tokens
# Permissions: repo, workflow
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here

# Filesystem - Project Directory Access
# Customize path to your projects directory
FILESYSTEM_PATH=/Users/${USER}/Documents/DM4

# ============================================================
# DATABASE & BACKEND
# ============================================================

# Supabase - Database Management
# Get from: https://app.supabase.com/account/tokens
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here
SUPABASE_PROJECT_REF=your_project_ref_here

# ============================================================
# DEPLOYMENT PLATFORMS
# ============================================================

# Netlify - Static Site Deployment
# Get from: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=your_netlify_token_here

# Vercel - Deployment Platform (using remote MCP URL)
# No token needed - uses public remote server

# Railway - Deployment Platform
# Get from: https://railway.app/account/tokens
RAILWAY_API_TOKEN=your_railway_token_here

# DigitalOcean - Cloud Services
# Get from: https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_API_TOKEN=your_digitalocean_token_here

# ============================================================
# CLOUD SERVICES
# ============================================================

# Cloudinary - Image and Video Management
# Get from: https://cloudinary.com/console/settings/security
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Airtable - Database
# Get from: https://airtable.com/create/tokens
AIRTABLE_API_KEY=your_airtable_key_here

# ============================================================
# WEB AUTOMATION & SCRAPING
# ============================================================

# Firecrawl - Web Scraping Service
# Get from: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=your_firecrawl_key_here

# Puppeteer - Browser Automation (no credentials needed)

# Fetch - Web Fetching (no credentials needed)

# Apify - Web Scraping (using remote MCP URL, no credentials needed)

# ============================================================
# DESIGN TOOLS
# ============================================================

# Figma - Design Tool Integration
# Get from: https://www.figma.com/developers/api#access-tokens
FIGMA_API_KEY=your_figma_key_here

# ============================================================
# AI SERVICES
# ============================================================

# Replicate - AI Model Inference
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here

# Google Gemini - Nano Banana AI
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# ============================================================
# MARKETING & AUTOMATION
# ============================================================

# DataForSEO - Keyword Research
# Get from: https://app.dataforseo.com/api-dashboard
DATAFORSEO_USERNAME=your_email@example.com
DATAFORSEO_PASSWORD=your_dataforseo_password_here

# n8n - Workflow Automation
# Get from: https://app.n8n.cloud/settings/api
N8N_API_URL=https://your-instance.app.n8n.cloud/api/v1
N8N_API_KEY=your_n8n_api_key_here

# GoHighLevel - CRM and Marketing Automation
# Get from: https://marketplace.gohighlevel.com/
GHL_API_KEY=your_ghl_api_key_here
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_LOCATION_ID=your_location_id_here

# ============================================================
# NOTES
# ============================================================
# - Keep this file in sync with your actual .env
# - Store .env in password manager for backup
# - Use ${VAR:-default} syntax for default values
# - Some servers work without credentials (marked above)
# - Remote MCP servers (Vercel, Apify) don't need tokens
